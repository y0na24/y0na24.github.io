---
import '../styles/global.css'

import hero480 from 'src/assets/manufacture-480.webp'
import hero768 from 'src/assets/manufacture-768.webp'
import hero1440 from 'src/assets/manufacture-1440.webp'
import hero1920 from 'src/assets/manufacture-1920.webp'

interface Props {
	title?: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang='ru'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width' />
		<meta
			name='keywords'
			content='Производство военной тары, Промышленная тара, Тара для военной техники, Тара для промышленного оборудования, Деревянные ящики для военной техники, Упаковка для боеприпасов и оружия, Тара для ракетной техники, Упаковка для авиационного оборудования, Транспортная тара для химической продукции, Производитель промышленной тары, Герметичные контейнеры для оборудования, Тара для электрооборудования, Тара для пивоваренной продукции, Производство тары для оборонной промышленности, Изготовление металлических контейнеров, Деревянные ящики для перевозки продукции, Упаковка для пищевой промышленности, СМК и ОКВЭД производство тары, Высококачественная промышленная тара'
		/>
		<meta property='og:url' content='https://altair-tara.ru' />
		<meta property='og:locale' content='ru_RU' />
		<meta
			property='og:site_name'
			content='Альтаир | Производство деревянной и военной тары'
		/>
		<meta property='og:type' content='website' />
		<meta name='robots' content='index, follow' />
		<meta
			property='og:title'
			content='Альтаир | Производство деревянной и военной тары'
		/>
		<meta name='yandex-verification' content='5b8cd838db373e93' />
		<meta
			name='description'
			content='Компания «Альтаир» — производитель высококачественной деревянной и военной тары, предоставляющий решения для упаковки и транспортировки военной техники, оборудования и боеприпасов. Мы обеспечиваем полный цикл: от разработки до доставки.'
		/>
		<title>
			{title || 'Альтаир | Производство деревянной и военной тары'}
		</title>
		<link rel='shortcut icon' href='/altair.svg' />
		<meta name='generator' content={Astro.generator} />
		<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
		<link rel='preload' as='image' href={hero480.src} />
		<link rel='preload' as='image' href={hero768.src} />
		<link rel='preload' as='image' href={hero1440.src} />
		<link rel='preload' as='image' href={hero1920.src} />

		<script type='application/ld+json'>
			{
				"@context": "https://schema.org",
				"@type": "Organization",
				"name": "Альтаир",
				"url": "https://altair-tara.ru",
				"logo": "/altair.svg",
				"contactPoint": {
					"@type": "ContactPoint",
					"telephone": "+7-960-170-0759",
					"contactType": "customer service",
					"areaServed": "RU",
					"availableLanguage": "Russian"
				}
			}
		</script>
		<!-- Yandex.Metrika counter -->
		<script type='text/javascript'>
			;(function (m, e, t, r, i, k, a) {
				m[i] =
					m[i] ||
					function () {
						;(m[i].a = m[i].a || []).push(arguments)
					}
				m[i].l = 1 * new Date()
				for (var j = 0; j < document.scripts.length; j++) {
					if (document.scripts[j].src === r) {
						return
					}
				}
				;(k = e.createElement(t)),
					(a = e.getElementsByTagName(t)[0]),
					(k.async = 1),
					(k.src = r),
					a.parentNode.insertBefore(k, a)
			})(
				window,
				document,
				'script',
				'https://mc.yandex.ru/metrika/tag.js',
				'ym'
			)

			ym(99459117, 'init', {
				clickmap: true,
				trackLinks: true,
				accurateTrackBounce: true,
				webvisor: true,
				ecommerce: 'dataLayer',
			})
		</script>
		<noscript
			><div>
				<img
					src='https://mc.yandex.ru/watch/99459117'
					style='position:absolute; left:-9999px;'
					alt=''
				/>
			</div></noscript
		>
		<!-- /Yandex.Metrika counter -->
	</head>
	<body class='wrapper'>
		<slot />
	</body>
</html>
