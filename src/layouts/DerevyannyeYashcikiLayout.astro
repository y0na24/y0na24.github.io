---
import '../styles/global.css'

import hero480 from 'src/assets/manufacture-480.webp'
import hero768 from 'src/assets/manufacture-768.webp'
import hero1440 from 'src/assets/manufacture-1440.webp'
import hero1920 from 'src/assets/manufacture-1920.webp'

interface Props {
	title?: string
	description?: string
	path?: string
}

const { title, description, path } = Astro.props
---

<!doctype html>
<html lang='ru'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width' />
		<meta name='keywords' content='Деревянная тара, деревянные ящики' />
		<meta property='og:url' content={`https://altair-tara.ru/${path}`} />
		<meta property='og:locale' content='ru_RU' />
		<meta property='og:site_name' content='Деревянные ящики | Альтаир' />
		<meta property='og:type' content='website' />
		<meta name='robots' content='index, follow' />
		<meta
			property='og:title'
			content={`${title} | Альтаир` || 'Деревянные ящики | Альтаир'}
		/>
		<meta
			name='description'
			content={description ||
				'На странице представлена информация о производстве специализированной тары для военной техники и промышленности. Мы изготавливаем высококачественные металлические и деревянные контейнеры для защиты и транспортировки военной продукции.'}
		/>
		<title>
			{
				`${title} | Альтаир` ||
					'Альтаир | Производство тары для промышленности и военной техники'
			}
		</title>
		<link rel='shortcut icon' href='/altair.svg' />
		<meta name='generator' content={Astro.generator} />
		<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />

		<script type='application/ld+json'>
			{
				"@context": "https://schema.org",
				"@type": "Product",
				"name": "Деревянные ящики",
				"description": "Высококачественная тара для транспортировки и защиты военной техники, произведенная компанией «Альтаир». Герметичные и безопасные контейнеры для перевозки боеприпасов, оружия и прочего оборудования.",
				"image": "/src/assets/manufacture-1920.webp",
				"url": "https://altair-tara.ru/derevyannye-yashchiki",
				"brand": {
					"@type": "Brand",
					"name": "Альтаир"
				},
				"offers": {
					"@type": "Offer",
					"url": "https://altair-tara.ru/derevyannye-yashchiki",
					"priceCurrency": "RUB",
					"price": "по запросу",
					"itemCondition": "https://schema.org/NewCondition",
					"availability": "https://schema.org/InStock"
				}
			}
		</script>
	</head>
	<body class='wrapper'>
		<slot />
	</body>
</html>
