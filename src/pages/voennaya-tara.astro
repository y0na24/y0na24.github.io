---
import { Image } from 'astro:assets'
import Header from 'src/shared/ui/Header.astro'

import voennayaTara from 'src/assets/voennayaTara.jpg'
import voennayaTara2 from 'src/assets/voennayaTara-2.jpg'
import voennayaTara3 from 'src/assets/voennayaTara-3.jpg'
import voennayaTara4 from 'src/assets/voennayaTara-4.jpg'
import voennayaTara5 from 'src/assets/voennayaTara-5.jpg'
import voennayaTara6 from 'src/assets/voennayaTara-6.jpg'
import BurgerSidebar from 'src/shared/ui/BurgerSidebar.astro'
import VoennayaTaraLayout from 'src/layouts/VoennayaTaraLayout.astro'

const options = [
	{
		images: [
			voennayaTara,
			voennayaTara2,
			voennayaTara3,
			voennayaTara4,
			voennayaTara5,
			voennayaTara6,
		],
		alt: 'Военная тара',
		description:
			'Военная тара отличается высокой прочностью и устойчивостью к механическим повреждениям, поскольку она предназначена для перевозки оружия, боеприпасов и других специфических грузов. Для её производства используются только высококачественные материалы, такие как массив сосны или фанера. Конструкция дополнительно укрепляется металлическими элементами для увеличения надёжности. Изготовление армейской тары и ложементов может быть стандартным, в соответствии с ГОСТом, или индивидуальным — по запросам заказчика. Большой опыт нашей компании позволяет разработать чертежи ящиков, подобрать материалы и произвести необходимую партию строго в оговоренные сроки.',
		path: 'voennaya-tara/',
	},
]

const productionProcess = [
	{
		title: 'Выбор древесины',
		description:
			'Для изготовления используются твердые и хвойные породы древесины. Основное требование — прочность материала, устойчивость к механическим повреждениям, влаге и воздействию внешней среды. Наиболее часто применяются сосна, ель, фанера.',
	},
	{
		title: 'Подготовка древесины',
		description:
			'На этом этапе древесина подвергается сушке для снижения её влажности до оптимальных значений (обычно около 12-15%). Это необходимо для предотвращения деформации готовых изделий и повышения их долговечности.',
	},
	{
		title: 'Распиловка и обработка заготовок',
		description:
			'Доски и брусья распиливаются по заданным размерам. Поверхность заготовок шлифуется для устранения дефектов и заусенцев, которые могут повредить содержимое тары или затруднить её использование.',
	},
	{
		title: 'Сборка и крепление элементов',
		description:
			'Основными видами соединений при сборке являются клеевые, шурупные или гвоздевые крепления. Для дополнительной прочности могут использоваться металлические уголки и пластины.',
	},
	{
		title: 'Обработка защитными составами',
		description:
			'Готовая тара обрабатывается антисептическими и огнеупорными составами для предотвращения гниения, поражения насекомыми и возгорания. В некоторых случаях тара дополнительно покрывается водоотталкивающим слоем.',
	},
	{
		title: 'Маркировка',
		description:
			'На поверхность тары наносится маркировка, содержащая информацию о содержимом, допустимых условиях хранения и транспортировки. Также указываются серийный номер и производитель.',
	},
]

const { description, path } = options[0]
---

<VoennayaTaraLayout
	title={'Военная тара'}
	description={description}
	path={path}
>
	<section class='option__section'>
		<BurgerSidebar />
		<div class='container'>
			<Header class='option__header' />
			<h1 class='title option__title'>Военная тара</h1>
			{
				options.map(({ images, description, alt }) => (
					<div class='option__block'>
						<p class='description option__description'>{description}</p>
						<ul class='option__grid'>
							{images.map(image => (
								<li>
									<Image class='option__image' src={image} alt={alt} />
								</li>
							))}
						</ul>
					</div>
				))
			}
			<div class='option__block'>
				<h3 class='subtitle_xl option__subtitle'>Подробная информация</h3>
				<p class='description option__description'>
					Военная деревянная тара играет ключевую роль в обеспечении
					сохранности, транспортировки и хранения вооружения, боеприпасов,
					снаряжения и различных военных грузов. Качество такой тары напрямую
					влияет на боеспособность и эффективность работы вооруженных сил,
					поскольку от неё зависит надежность доставки грузов в исправном
					состоянии. Производство военной тары должно соответствовать строгим
					требованиям, определенным стандартами и нормативами.
				</p>
				<p class='description option__description'>
					Производственный процесс изготовления армейских ящиков включает
					несколько ключевых этапов:
				</p>
				<ul>
					{
						productionProcess.map((p, i) => (
							<li>
								<h3 class='description'>
									{i + 1}. {p.title}
								</h3>
								<p class='description option__description'>{p.description}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>
</VoennayaTaraLayout>

<style>
	.option__header {
		margin-bottom: 40px;
		background-color: #bbbbbb;
	}

	.option__description {
		font-weight: 500;
		margin-bottom: 15px;
	}

	.option__block {
		background-color: var(--white-color);
		padding: 15px;
		margin-bottom: 30px;
		border-radius: var(--card-border-radius);
	}

	.option__grid {
		display: grid;
		grid-template-columns: repeat(1, 1fr);
		gap: 20px;
	}

	.option__card {
		background-color: #f0f0f0;
		padding: 20px;
		height: 300px;
	}

	.option__image {
		width: 100%;
		height: 250px;
		object-fit: cover;
		border-radius: var(--card-border-radius);
	}

	.option__subtitle {
		margin-bottom: 15px;
	}

	.option__title {
		margin-bottom: 20px;
	}

	@media screen and (min-width: 768px) {
		.option__grid {
			grid-template-columns: repeat(1, 1fr);
		}
		.option__image {
			height: 400px;
		}
	}

	@media screen and (min-width: 1024px) {
		.option__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media screen and (min-width: 1440px) {
		.option__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
